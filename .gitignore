# MPLAB X Project Files
# Ignore all build output from any .X project directories
**/*.X/dist/
**/*.X/build/
**/*.X/.generated_files/
**/*.X/nbproject/private/
**/*.X/nbproject/Makefile-*
**/*.X/nbproject/Package-*.bash
**/*.X/nbproject/*.properties
**/*.X/debug/
**/*.X/production/
**/*.X/disassembly/
**/*.X/queuelogs/
**/*.X/daqifi_*.bak*/

# Build artifacts (anywhere in the tree)
*.hex
*.elf
*.map
*.d
*.o
*.obj
*.lst
*.pre
*.p1
*.production
*.debug
memoryfile.xml

# Local secrets / env (e.g. WIFI_PASS for bench testing)
.env
.env.*
!.env.example

# OS-specific files
.DS_Store
Thumbs.db
*~
*.swp
*.bak

# IDE-specific files
nbactions.xml
nb-configuration.xml
funclist

# Temporary files
*.tmp
*.temp

# Log files
*.log
MPLABXLog.xml
defmplabxtrace.log.inx

# Local settings
.vscode/
.idea/
*.suo
*.user
__pycache__/

# Claude/AI assistant files
.claude/settings.local.json
.claude/COM3
bq24297.*
*.ps1
.pr_agent*

# Entire CLI local data (removed 2026-09-15). The tool was uninstalled, but a checkout that ran it
# can still hold session checkpoints and transcripts under .entire/ (metadata/, logs/, tmp/,
# settings.local.json). Keep all of it out of git -- a stray `git add -A` must not commit it.
/.entire/
