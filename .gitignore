**/*.X/dist/
**/*.X/build/
**/*.X/.generated_files/
**/*.X/nbproject/private/
**/*.X/nbproject/Makefile-*
**/*.X/nbproject/Package-*.bash
**/*.X/nbproject/*.properties
**/*.X/debug/
**/*.X/production/
**/*.X/disassembly/
**/*.X/queuelogs/
**/*.X/daqifi_*.bak*/

# Build artifacts (anywhere in the tree)
*.hex
*.elf
*.map
*.d
*.o
*.obj
*.lst
*.pre
*.p1
*.production
*.debug
memoryfile.xml

# Local secrets / env (e.g. WIFI_PASS for bench testing)
.env
.env.*
!.env.example

# OS-specific files
.DS_Store
Thumbs.db
*~
*.swp
*.bak

# IDE-specific files
nbactions.xml
nb-configuration.xml
funclist

# Temporary files
*.tmp
*.temp

# Log files
*.log
MPLABXLog.xml
defmplabxtrace.log.inx

# Local settings
.vscode/
.idea/
*.suo
*.user
__pycache__/

# Claude/AI assistant files
.claude/settings.local.json
.claude/COM3
bq24297.*
*.ps1
.pr_agent*

# Entire CLI local data (removed 2026-09-15). The tool was uninstalled, but a checkout that ran it
# can still hold session checkpoints and transcripts under .entire/ (metadata/, logs/, tmp/,
# settings.local.json). Keep all of it out of git -- a stray `git add -A` must not commit it.
/.entire/

# Secrets and credentials. This repo is PUBLIC and the agent workflow routinely
# runs `git add -A`, so a credential file dropped in a checkout is one careless
# commit away from being published. None of these patterns matches anything
# tracked today (verified across all paths including firmware/src/third_party),
# so this is purely preventative -- it changes no current file's status.
.env
.env.*
# ...but KEEP the committed template: `.env.*` above would otherwise match it,
# and while gitignore cannot untrack an already-tracked file, a future remove-
# and-re-add would silently skip it. The documented workflow is to copy this
# template to .env and fill it in, which is exactly what must stay ignored.
!.env.example
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
credentials.json
*.tfstate

# ⚠ Interaction worth knowing about: `git clean -fd` does NOT remove ignored
# files. The wolfSSL revert recipe in CLAUDE.md (`git checkout --` +
# `git clean -fd` over firmware/src/third_party/wolfssl/ after an MCC session)
# would therefore leave behind any *.pem / *.key that a regeneration produced,
# and `git status` would not show them either. wolfSSL ships no such files in
# this repo today, so nothing is affected now -- but use `git clean -fdx` there
# if that ever changes.
